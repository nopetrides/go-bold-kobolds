        VariableType: 1
        _rangeHelper: {x: 0, y: 0, z: 0, w: 0}
      - VariableName: 'Sensitive Blend:'
        Tooltip: When collision happens, applying blending also on the first parent
          bones of the chain (like arm collision -> blend upper chest too)
        _value: {x: 1, y: 0, z: 0, w: 0}
        _string: 
        _curve:
          serializedVersion: 2
          m_Curve: []
          m_PreInfinity: 2
          m_PostInfinity: 2
          m_RotationOrder: 4
        _uObject: {fileID: 0}
        VariableType: 1
        _rangeHelper: {x: 0, y: 0, z: 0, w: 0}
      - VariableName: 'Skip Feet:'
        Tooltip: 'Skipping checking last leg bones collision state to avoid blending
          legs every time feet are touching ground.


          With legs turned
          off, this option will disable blending in feet bones on leg blend request.'
        _value: {x: 1, y: 0, z: 0, w: 0}
        _string: 
        _curve:
          serializedVersion: 2
          m_Curve: []
          m_PreInfinity: 2
          m_PostInfinity: 2
          m_RotationOrder: 4
        _uObject: {fileID: 0}
        VariableType: 1
        _rangeHelper: {x: 0, y: 0, z: 0, w: 0}
